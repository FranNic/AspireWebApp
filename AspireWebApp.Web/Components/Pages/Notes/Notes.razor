@page "/notes"
@using MudExRichTextEditor
@inject NotesApiClient NotesApiClient

@* <MudCheckBox Label="Read only" @bind-Checked="_readOnly" /> *@

<MudContainer MaxWidth="MaxWidth.Large">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudForm @ref="form" @bind-IsValid="@success" @bind-Errors="@errors" Model="NoteToAdd">
                <MudTextField T="string" Label="Title" Required="true" RequiredError="Title is required!" @bind-Value="NoteToAdd.Title" />
                <MudExRichTextEdit @ref="@RichTextEditor"
                                   ReadOnly="@_readOnly"
                                   Height="444"
                                   Class="m-2"
                                   Placeholder="Write here...">

                </MudExRichTextEdit>
            </MudForm>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(()=>AddNote())">Add</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(()=>DeleteNote())">Delete</MudButton>
        </MudItem>

        <MudItem xs="12" sm="6" md="8">
            <MudPaper Class="pa-4 mud-height-full">
                <MudStack>
                    @foreach (var note in noteDtos)
                    {
                        <MudPaper Class="pa-3">
                            <span>@note.Title</span>
                            <span style="color:#979797">
                                @((MarkupString)@note.Content)
                                
                            </span>

                            @*  <MudToggleIconButton Toggled="(ShowDeleteConfirmation && ItemToDelete == item.Id)"
                                                     ToggledChanged="async result => await SwitchDeleteConfirmation(item.Id)"
                                                     Icon="@Icons.Material.Filled.Delete"
                                                     Color="@Color.Secondary"
                                                     ToggledIcon="@Icons.Material.Filled.Cancel"
                                                     ToggledColor="@Color.Default"
                                                     title="@(item.IsDone ? "Done" : "NotDone")" />
                                <MudIconButton Class="@(ShowDeleteConfirmation && ItemToDelete == item.Id ? "": "invisible")" Icon="@Icons.Material.Filled.Delete" aria-label="delete" Color="Color.Error" OnClick="@(async result => await ConfirmDeleteAsync(item.Id))" /> *@
                        </MudPaper>

                    }
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>
@code {
    private bool _readOnly = false;
    private MudExRichTextEdit RichTextEditor { get; set; }
    string RichTextHTMLContent;

    private List<NoteDto> noteDtos { get; set; } = new List<NoteDto>();
    bool success;
    string[] errors = { };
    MudForm form;
    private DateTime? _date = DateTime.Today; // Date needs to be initialized or used outside the object.
    private NoteDto? NoteToAdd { get; set; } = new();

    // get text from the editor
    private async Task GetText()
    {
        var text = await RichTextEditor.GetText();
        Console.WriteLine("Text: " + text);
    }

    private async Task GetContent()
    {
        var content = await RichTextEditor.GetContent();
        Console.WriteLine("Content: " + content);
    }

    protected override async Task OnInitializedAsync()
    {
        noteDtos = await NotesApiClient.GetNotesAsync();
    }

    private async Task AddNote()
    {
        NoteToAdd.Category = "";
        NoteToAdd.Content = await RichTextEditor.GetHtml();
        NoteToAdd.CreatedAt = DateTime.Now;
        NoteToAdd.UpdatedAt = DateTime.Now;
        NoteToAdd.Tags = NoteToAdd.Title.Split(" ");

        var response = await NotesApiClient.CreateNoteAsync(NoteToAdd, new CancellationToken());
        if (response != null)
        {
            noteDtos.Add(response);
        }
    }

    private async Task DeleteNote()
    {
        var note = new NoteDto
            {
                Content = await RichTextEditor.GetContent()
            };

        var response = await NotesApiClient.DeleteNoteAsync(note.Id, new CancellationToken());
        if (response)
        {
            noteDtos.Remove(note);
        }
    }

    public async void GetHTML()
    {
        RichTextHTMLContent = await this.RichTextEditor.GetHtml();
        StateHasChanged();
    }

}